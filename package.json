{
  "name": "laa-express-typescript-template",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/index.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "overrides": {
    "picomatch": "^4.0.0",
    "ip-address": "^10.3.1",
    "brace-expansion": "^5.0.0"
  },
  "scripts": {
    "start": "bun public/index.js",
    "clean": "rimraf public",
    "build": "bun run clean && bun esbuild.ts",
    "lint": "bunx eslint . --fix",
    "lint:check": "bunx eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently \"bun esbuild.ts --watch\" \"bun --watch src/index.ts\"",
    "deploy": "./scripts/deploy.sh",
    "prepare": "command -v git >/dev/null 2>&1 && (git config --unset core.hooksPath 2>/dev/null || true) && bun lefthook install || echo 'Skipping lefthook install (git not found)'",
    "security:zap:ci": "./deploy/scripts/zap/zap-run-cicd.sh",
    "security:zap:local": "./deploy/scripts/zap/zap-run-local.sh",
    "test": "bun run test:unit && bun run test:playwright",
    "test:unit": "bun test ./tests/unit",
    "test:playwright": "mise build; bunx playwright test",
    "pretest:playwright": "docker rm -f wiremock-pw redis-pw-${REDIS_PORT:-6379} || true && docker run -d --name redis-pw-${REDIS_PORT:-6379} -p ${REDIS_PORT:-6379}:6379 redis:7-alpine",
    "posttest:playwright": "docker rm -f redis-pw-${REDIS_PORT:-6379} || true",
    "coverage:unit": "rimraf coverage/unit && bun test --preload ./scripts/coverageTools/unitPreload.ts ./tests/unit && nyc report --temp-dir coverage/unit/raw --report-dir coverage/unit --reporter=text --reporter=lcov --reporter=html",
    "coverage:unit:html": "bun run coverage:unit",
    "coverage:unit:check": "bun run coverage:combined:check",
    "coverage:playwright": "rimraf coverage/playwright && cross-env PLAYWRIGHT_COVERAGE=true bun run test:playwright && nyc report --temp-dir coverage/playwright/raw --report-dir coverage/playwright --reporter=text --reporter=lcov --reporter=html",
    "coverage:combined:report": "bun scripts/coverageTools/mergeCoverage.ts && nyc report --temp-dir coverage/combined/raw --report-dir coverage/combined --reporter=text --reporter=lcov --reporter=html",
    "coverage:combined": "rimraf coverage && bun run coverage:unit && bun run coverage:playwright && bun run coverage:combined:report",
    "coverage:combined:check": "bun run coverage:combined && bun scripts/checkCoverage.ts",
    "coverage:combined:check-artifacts": "bun run coverage:combined:report && bun scripts/checkCoverage.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@ministryofjustice/frontend": "^11.0.0",
    "@zod/core": "^0.11.6",
    "accessible-autocomplete": "^3.0.1",
    "axios": "1.20.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "fs-extra": "^11.3.4",
    "govuk-frontend": "^6.5.0",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jwks-rsa": "^4.0.1",
    "multer": "2.3.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/connect-livereload": "0.6.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/fs-extra": "11.0.4",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.0",
    "@types/nunjucks": "3.2.6",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "axe-core": "4.13.0",
    "chokidar": "5.0.0",
    "concurrently": "10.0.5",
    "connect-livereload": "0.6.1",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "eslint-config-love": "155.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.3.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "lefthook": "2.1.12",
    "lint-staged": "17.4.1",
    "livereload": "0.10.3",
    "middleware-axios": "3.0.0",
    "nyc": "^18.0.0",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sass": "1.103.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@ministryofjustice/frontend@10.0.0": "patches/@ministryofjustice%2Ffrontend@10.0.0.patch"
  }
}
