{% extends "base.njk" %}
{%- from "govuk/components/file-upload/macro.njk" import govukFileUpload -%}
{%- from "govuk/components/button/macro.njk" import govukButton -%}
{%- from "govuk/components/error-summary/macro.njk" import govukErrorSummary -%}
{%- from "moj/components/multi-file-upload/macro.njk" import mojMultiFileUpload -%}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary.items.length %}
        {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errorSummary.items
      }) }}
      {% endif %}
      {% if errors %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
      {% endif %}
      <h1 class="govuk-heading-xl">{{ "Upload supporting documents" }}</h1>
      {% include introTemplate %}
      <form action="{{ formAction }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% set uploadHtml %}
          {{ govukFileUpload({
          id: "PriorAuthorityDocuments",
          name: "PriorAuthorityDocuments",
          value: priorAuthority.uploadedDocuments,
          classes: "moj-multi-file-upload__input",
          label: {
            text: "Upload files",
            classes: "govuk-label--m"
          },
          hint:{
          text:"The maximum file size for each file is 10MB. Files must be a DOC, DOCX, RTF, ODT, JPG, BMP, PNG, TIF or PDF."
          },
          attributes: { multiple: "" },
          errorMessage: ({ text: errorMap["PriorAuthorityDocuments"] } if errorMap["PriorAuthorityDocuments"] else null)
        }) }}
          {{ govukButton({
          text: "Upload file",
          classes: "govuk-button--secondary moj-multi-file-upload__button",
          name: "_action",
          value: "upload"
        }) }}
          {% endset %}
          {{ mojMultiFileUpload({
        label: { text: "Upload or drag and drop documents" },
        uploadedFiles: {
          heading: { text: "Uploaded files" },
          items: uploadedFiles
        },
        uploadHtml: uploadHtml,
        attributes: {
          "data-ajax-upload-url": uploadUrl,
          "data-ajax-delete-url": deleteUrl
        }
      }) }}
          {% if uploadedFiles.length == 0 %}
            <div id="uploaded-files-empty-table" class="moj-multi-file__uploaded-files">
              <h2 class="govuk-heading-m">Uploaded files</h2>
              <div class="govuk-summary-list moj-multi-file-upload__list">
                <div class="govuk-summary-list__row moj-multi-file-upload__row moj-multi-file-upload__header-row">
                  <div class="govuk-summary-list__value">
                    <strong>File name</strong>
                  </div>
                  <div class="govuk-summary-list__actions">
                    <strong>Action</strong>
                  </div>
                </div>
                <div class="govuk-summary-list__row moj-multi-file-upload__row moj-multi-file-upload__empty-row">
                  <div class="govuk-summary-list__value moj-multi-file-upload__message">
                    <strong data-empty-uploaded-files="true">No files added</strong>
                  </div>
                  <div class="govuk-summary-list__actions moj-multi-file-upload__actions"></div>
                </div>
              </div>
            </div>
          {% endif %}
          <div class="govuk-button-group standard-spacing-top">
            {{ govukButton({ text: "Save and continue", attributes: { name: "_action", value: 'continue' } }) }}
          </div>
        </form>
      </div>
    </div>
  {% endblock %}
  {% block bodyEnd %}
    {{ super() }}
    <script type="module" nonce="{{ cspNonce }}" src="/js/{{ getAsset('custom','min.js') }}"></script>
  {% endblock %}