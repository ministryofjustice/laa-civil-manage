{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% block beforeContent %}
    {{ govukBackLink({
    text: "Back",
    href: "/applications/manage/" + applicationId
  }) }}
{% endblock %}
{% block content %}
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Request prior authority to incur a disbursement</h1>
                <p class="govuk-body">Use this service to ask the Legal Aid Agency (LAA) to approve a disbursement before you incur the
                    cost.</p>
                <p class="govuk-body">A disbursement is a payment to another person or organisation for something needed to conduct a
                    legally aided civil case.</p>
                <h2 class="govuk-heading-m">Before you start</h2>
                <p class="govuk-body">You will need:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>details of the disbursement</li>
                    <li>the total amount you are applying for</li>
                    <li>an explanation of why the disbursement is necessary</li>
                </ul>
                {{ govukButton({
  text: "Start",
  href: "/prior-authority/disbursement/details",
  classes: "standard-spacing-top",
  isStartButton: true
}) }}
            </div>
        </div>
    </div>
{% endblock %}