{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: "Prior authority application submitted",
        html: "for <br><strong>" + laaReference + "</strong>"

      }) }}
      <p class="govuk-body">We've sent you a confirmation email.</p>
      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">
        We’ll review this application and email you with our decision. We’ll also update your dashboard.
      </p>
      <a
        href="/applications/manage/{{ applicationId }}"
        role="button"
        draggable="false"
        class="govuk-button"
        data-module="govuk-button"
        data-govuk-button-init="">Manage your application</a>
    </div>
  </div>
{% endblock %}