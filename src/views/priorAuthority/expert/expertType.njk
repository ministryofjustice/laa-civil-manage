{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% block beforeContent %}
  {{ govukBackLink({
  text: "Back",
  href: "/prior-authority/expert"
}) }}
{% endblock %}
{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% if errors %}
          {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
        {% endif %}
        <span class="govuk-caption-l">Prior authority for {{ laaReference }}</span>
        <form action="/prior-authority/expert/expert-type" method="post" novalidate>
          {% set selectedExpertType = values.PriorAuthorityExpertType if values else 
            fallbackSelectedExpertType %}
          {% set displayedExpertType = selectedExpertType %}
          <div class="govuk-form-group">
            {{ govukSelect({
              id: "PriorAuthorityExpertType",
              name: "PriorAuthorityExpertType",
              errorMessage: ({ text: errorMap["PriorAuthorityExpertType"] } if errorMap["PriorAuthorityExpertType"] else null),
              label: {
                text: "Service required",
                classes: "govuk-label--l",
                isPageHeading: true
              },
              value: selectedExpertType,
              hint: {
                text: "If you are unable to find the service you require, select Other"
              },
              items: expertTypes
            }) }}
          </div>

          <div class="govuk-button-group standard-spacing-top">
            {{ govukButton({ text: "Continue", attributes: { name: "_action", value: 'continue' } }) }}
          </div>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}"></form>
      </div>
    </div>
  </div>
  {% block pageScripts %}
    <script nonce="{{ cspNonce }}" src="/js/{{ getAsset('accessible-autocomplete', 'min.js') }}"></script>
    <script nonce="{{ cspNonce }}">
      document.addEventListener("DOMContentLoaded", function () {
        const selectElement = document.querySelector('#PriorAuthorityExpertType');
        const displayedExpertType = {{ (displayedExpertType or '') | dump | safe }};

        if (selectElement && typeof accessibleAutocomplete !== 'undefined') {
          const optionTexts = Array
            .prototype
            .slice
            .call(selectElement.options)
            .map(function (option) {
              return option.textContent || option.innerText;
            })
            .filter(function (text) {
              return text && text.trim() !== '';
            });

          function expertTypeSource(query, populateResults) {
            const trimmedQuery = (query || '')
              .trim()
              .toLowerCase();
            const matches = optionTexts.filter(function (text) {
              return text
                .toLowerCase()
                .indexOf(trimmedQuery) !== -1;
            });
            populateResults(
              matches.length > 0
              ? matches
              : ['Other']);
          }

          accessibleAutocomplete.enhanceSelectElement({
            selectElement: selectElement,
            source: expertTypeSource,
            displayMenu: 'inline',
            showAllValues: true,
            autoselect: false,
            confirmOnBlur: false,
            defaultValue: displayedExpertType,
            dropdownArrow: function (config) {
              return '<svg class="' + config.className + '" viewBox="0 0 24 24" focusable="false" aria-hidden="true">' + '<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5"></path>' + '</svg>';
            }
          });
          const generatedInput = document.getElementById('PriorAuthorityExpertType');
          const originalSelect = document.getElementById('PriorAuthorityExpertType-select');
          if (generatedInput && originalSelect) {
            if (displayedExpertType) {
              generatedInput.value = displayedExpertType;
            }
            generatedInput.name = originalSelect.name;
            originalSelect.removeAttribute('name');
          }

          const expertTypeLabel = document.querySelector('label[for="PriorAuthorityExpertType"]');
          if (expertTypeLabel) {
            expertTypeLabel.addEventListener('click', function (event) {
              event.preventDefault();
            });
          }
        }
      });
    </script>
  {% endblock %}
{% endblock %}