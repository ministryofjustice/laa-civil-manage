{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro expertSummaryCards(priorAuthority, basePath) %}
  {{ govukSummaryList({
    card: {
      title: { text: "Expert details" }
    },
    rows: [
      {
        classes: "govuk-summary-list__row--no-border",
        key: { text: "Expert type" },
        value: { text: priorAuthority.expertType or "Not provided" },
        actions: {
          items: [{
            href: basePath ~ "/details",
            text: "Change",
            classes: "govuk-link--no-visited-state",
            visuallyHiddenText: "expert type and full name"
          }]
        }
      },
      {
        key: { text: "Full name" },
        value: { text: priorAuthority.fullName or "Not provided" }
      },
      {
        key: { text: "Guideline rates or hours exceeded" },
        value: { text: priorAuthority.guidelineRatesExceeded or "Not provided" },
        actions: {
          items: [{
            href: basePath ~ "/is-guideline-rate-exceeded",
            text: "Change",
            classes: "govuk-link--no-visited-state",
            visuallyHiddenText: "guideline rates or hours exceeded"
          }]
        }
      },
      {
        key: { text: "Based in London" },
        value: { text: priorAuthority.expertBasedInLondon or "Not provided" },
        actions: {
          items: [{
            href: basePath ~ "/based-in-london",
            text: "Change",
            classes: "govuk-link--no-visited-state",
            visuallyHiddenText: "based in London"
          }]
        }
      }
    ]
  }) }}

  {% set summaryRows = [{
    key: { text: "Billing method" },
    value: { text: priorAuthority.billingType or "Not provided" }
  }] %}

  {% if priorAuthority.billingType == "Hourly" %}
    {% set _ = summaryRows.push({
      key: { text: "Hourly rate" },
      value: {
        text: "£" ~ priorAuthority.hourlyRate if priorAuthority.hourlyRate else "Not provided"
      }
    }) %}
    {% set hoursText = "1 Hour" if priorAuthority.estimatedTime.estimatedHours == 1 else priorAuthority.estimatedTime.estimatedHours ~ " Hours" %}
    {% set minutesText = "1 Minute" if priorAuthority.estimatedTime.estimatedMinutes == 1 else priorAuthority.estimatedTime.estimatedMinutes ~ " Minutes" %}
    {% set _ = summaryRows.push({
      key: { text: "Time requested" },
      value: { html: hoursText ~ " <br>" ~ minutesText }
    }) %}
    {% set _ = summaryRows.push({
      key: { text: "Total amount" },
      value: {
        text: "£" ~ priorAuthority.totalAmount if priorAuthority.totalAmount else "Not provided"
      }
    }) %}
  {% elif priorAuthority.billingType == "Fixed rate" %}
    {% set _ = summaryRows.push({
      key: { text: "Total amount" },
      value: {
        text: "£" ~ priorAuthority.fixedRateTotalAmount if priorAuthority.fixedRateTotalAmount else "Not provided"
      }
    }) %}
  {% endif %}

  {{ govukSummaryList({
    card: {
      title: { text: "Expert costs" },
      actions: {
        items: [{
          href: basePath ~ "/costs",
          text: "Change",
          classes: "govuk-link--no-visited-state",
          visuallyHiddenText: "expert costs"
        }]
      }
    },
    rows: summaryRows
  }) }}
{% endmacro %}

{% macro counselSummaryCards(priorAuthority, basePath) %}
  {% set counselTypeLabels = {
    "KINGS_COUNSEL_ALONE": "King's Counsel alone",
    "TWO_JUNIOR_COUNSEL": "Two Junior Counsel",
    "KINGS_COUNSEL_AND_JUNIOR_COUNSEL": "King's Counsel and Junior Counsel",
    "KINGS_COUNSEL_AND_TWO_JUNIOR_COUNSEL": "King's Counsel and Two Junior Counsel"
  } %}
  {% set counselTypeLabel = counselTypeLabels[priorAuthority.counselType] %}

  {{ govukSummaryList({
    card: {
      title: { text: "Counsel details" }
    },
    rows: [{
      key: { text: "Counsel type" },
      value: { text: counselTypeLabel or "Not provided" },
      actions: {
        items: [{
          href: basePath ~ "/type",
          text: "Change",
          classes: "govuk-link--no-visited-state",
          visuallyHiddenText: "counsel type"
        }]
      }
    }]
  }) }}
{% endmacro %}

{% macro justificationCard(justification, basePath) %}
  {% set justificationValueHtml %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-three-quarters-from-desktop">
        <p class="govuk-body govuk-!-margin-bottom-0">{{ (justification or "Not provided") | escape }}</p>
      </div>
    </div>
  {% endset %}

  {{ govukSummaryList({
    classes: "pa-justification-summary-list",
    card: {
      title: { text: "Justification" },
      actions: {
        items: [{
          href: basePath ~ "/justification",
          text: "Change",
          classes: "govuk-link--no-visited-state",
          visuallyHiddenText: "justification"
        }]
      }
    },
    rows: [{
      value: { html: justificationValueHtml }
    }]
  }) }}
{% endmacro %}

{% macro supportingDocumentsCard(uploadedDocuments, basePath) %}
  {% set documentListItems %}
    {% if uploadedDocuments and uploadedDocuments.length %}
      <ul class="govuk-list govuk-!-margin-bottom-0">
        {% for document in uploadedDocuments %}
          <li>{{ document.originalFileName }}</li>
        {% endfor %}
      </ul>
    {% else %}
      Not provided
    {% endif %}
  {% endset %}

  {{ govukSummaryList({
    card: {
      title: { text: "Supporting documents" },
      actions: {
        items: [{
          href: basePath ~ "/document-upload",
          text: "Change",
          classes: "govuk-link--no-visited-state",
          visuallyHiddenText: "supporting documents"
        }]
      }
    },
    rows: [{
      key: { text: "File names" },
      value: { html: documentListItems }
    }]
  }) }}
{% endmacro %}
