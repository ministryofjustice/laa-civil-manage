{% extends "base.njk" %}
{% from "components/multiFieldSearch/macro.njk" import multiFieldSearch %}
{%- from "moj/components/pagination/macro.njk" import mojPagination -%}
{%- from "govuk/components/table/macro.njk" import govukTable -%}
{% block content %}
  <h1 class="govuk-heading-xl ">Your granted certificates</h1>
  {{ multiFieldSearch(
  "/applications",
  [
    {
      id: "laa-reference",
      name: "laaReference",
      label: "LAA Reference"
    },
    {
      id: "client-first-name",
      name: "clientFirstName",
      label: "Client first name"
    },
    {
      id: "client-last-name",
      name: "clientLastName",
      label: "Client last name"
    }
  ],
  searchValues
) }}
  {% if applicationRows and applicationRows.length > 0 %}
    {{ govukTable({
      classes: "app-applications-table govuk-!-margin-top-6",
      firstCellIsHeader: true,
      attributes: { "data-module": "moj-sortable-table" },
      head: [
        { text: "Client Name" },
        { text: "LAA Reference" }
      ],
      rows: applicationRows
    }) }}
    {{ mojPagination(pagination) }}
  {% else %}
    <p class="govuk-body govuk-!-margin-top-6">No certificates found.</p>
  {% endif %}
{% endblock %}