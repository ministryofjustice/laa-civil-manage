{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/pa-form/is-guideline-rate-exceeded"
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errors
      }) }}
      {% endif %}
      <form action="/pa-form/expert-based-in-london" method="post" novalidate>
        {{ govukRadios({
        classes: "govuk-radios--inline",
        name: "expertBasedInLondon",
        errorMessage: ({ text: errorMap["expertBasedInLondon"] } if errorMap["expertBasedInLondon"] else null),
        fieldset: {
          legend: {
            text: "Is the expert based in London?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        items: [
          { value: "Yes", text: "Yes", checked: priorAuthority.expertBasedInLondon == "Yes" },
          { value: "No", text: "No", checked: priorAuthority.expertBasedInLondon == "No" }
        ]
      }) }}
        <div class="govuk-button-group">
          {{ govukButton({ text: "Save and continue", attributes: { name: "_action", value: 'continue' } }) }}
          {{ govukButton({ text: "Save and come back later", classes: "govuk-button--secondary", attributes: { name: "_action", value: 'draft' } }) }}
        </div>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}"></form>
      </div>
    </div>
  {% endblock %}