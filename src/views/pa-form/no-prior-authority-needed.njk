{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/pa-form/is-guideline-rate-exceeded"
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">You do not need to apply for prior authority</h1>
      <p class="govuk-body">This is because the expert you're instructing is working at or below the codified rate and within
        the guideline hours.</p>
      <p class="govuk-body standard-spacing-top">You can justify these costs on assessment.</p>
      {{ govukWarningText({
  text: "Applying for prior authority is not required based on your answers",
  iconFallbackText: "Warning",
  classes: "standard-spacing-top"
}) }}
      <div class="govuk-button-group standard-spacing-top">
        {{ govukButton({
          text: "Back to your applications",
          href: "#"
        }) }}
        <a href="/pa-form/expert-based-in-london" class="govuk-link">Continue applying for prior authority</a>
      </div>
    </div>
  </div>
{% endblock %}