{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/label/macro.njk" import govukLabel %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% block beforeContent %}
  {{ govukBackLink({
  text: "Back",
  href: "/pa-form/expert-based-in-london"
}) }}
{% endblock %}
{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% if errors %}
          {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
        {% endif %}
        <form action="/pa-form/expert-details" method="post" novalidate>
          {% set fullName = values.PriorAuthorityExpertFullName if values else priorAuthority.fullName %}
          <div class="govuk-form-group">
            <div style="display: flex; gap: 15px; align-items: flex-end;">
              <div style="flex-grow: 1;">
                {{ govukSelect({
                  id: "PriorAuthorityExpertType",
                  name: "PriorAuthorityExpertType",
                  errorMessage: ({ text: errorMap["PriorAuthorityExpertType"] } if errorMap["PriorAuthorityExpertType"] else null),
                  label: {
                    text: "Search for the expert type",
                    classes: "govuk-label--xl",
                    isPageHeading: true
                  },
                  value: priorAuthority.expertType,

                  hint: {
                    text: "Start typing and choose from the list. For example, physiotherapist"
                  },
                  items: expertTypes
                }) }}
              </div>
              <a
                href="#"
                class="govuk-link govuk-link--no-visited-state"
                id="clear-search-btn"
                style="margin-bottom: 0; display: none; white-space: nowrap; flex-shrink: 0;">
                Clear search
              </a>
            </div>
          </div>
          {{ govukInsetText({
  text: "Only experts applicable to SCA cases appear in this list. If you cannot find the category of expert you are looking for, enter it manually."
}) }}
          {{ govukInput({
            label: { text: "What is the full name of the expert?", classes: "govuk-label--m" },
            id: "PriorAuthorityExpertFullName",
            name: "PriorAuthorityExpertFullName",
            spellcheck: "false",
            value: fullName,
            errorMessage: ({ text: errorMap["PriorAuthorityExpertFullName"] } if errorMap["PriorAuthorityExpertFullName"] else null)
          }) }}
          <div class="govuk-button-group">
            {{ govukButton({ text: "Save and continue", attributes: { name: "_action", value: 'continue' } }) }}
            {{ govukButton({ text: "Save and come back later", classes: "govuk-button--secondary", attributes: { name: "_action", value: 'draft' } }) }}
          </div>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}"></form>
        </div>
      </div>
    </div>
    {% block pageScripts %}
      <link rel="stylesheet" href="https://unpkg.com/accessible-autocomplete@2.0.4/dist/accessible-autocomplete.min.css"/>
      <script src="https://unpkg.com/accessible-autocomplete@2.0.4/dist/accessible-autocomplete.min.js"></script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const selectElement = document.querySelector('#PriorAuthorityExpertType');
          const clearBtn = document.getElementById('clear-search-btn');
          if (selectElement && typeof accessibleAutocomplete !== 'undefined') {
            accessibleAutocomplete.enhanceSelectElement({selectElement: selectElement, displayMenu: 'overlay', defaultValue: ''});
            const generatedInput = document.getElementById('PriorAuthorityExpertType');
            const originalSelect = document.getElementById('PriorAuthorityExpertType-select');
            if (generatedInput && originalSelect) {
              generatedInput.name = originalSelect.name;
              originalSelect.removeAttribute('name');
            }
            if (clearBtn) {
              clearBtn.style.display = 'block';
              clearBtn.addEventListener('click', function () {
                const searchInput = document.getElementById('PriorAuthorityExpertType');
                if (searchInput) {
                  searchInput.value = '';
                  searchInput.focus();
                  searchInput.dispatchEvent(new Event('input', {bubbles: true}));
                }
              });
            }
          }
        });
      </script>
    {% endblock %}
  {% endblock %}