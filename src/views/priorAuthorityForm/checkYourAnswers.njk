{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <h1 class="govuk-heading-xl">Check your answers</h1>

    {% for card in summaryCards %}
      {{ govukSummaryList(card) }}
    {% endfor %}

    <form action="{{ formAction }}" method="post" novalidate>
      <div class="govuk-button-group standard-spacing-top">
        {{ govukButton({ text: "Submit", attributes: { name: "_action", value: 'continue' } }) }}
        {{ govukButton({ text: "Save and come back later", classes: "govuk-button--secondary", attributes: { name: "_action", value: 'draft' } }) }}
      </div>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    </form>
  </div>
{% endblock %}