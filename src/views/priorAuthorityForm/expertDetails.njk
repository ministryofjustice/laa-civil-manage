{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/label/macro.njk" import govukLabel %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% block beforeContent %}
  {{ govukBackLink({
  text: "Back",
  href: "/prior-authority-form/expert-based-in-london"
}) }}
{% endblock %}
{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% if errors %}
          {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
        {% endif %}
        <form action="/prior-authority-form/expert-details" method="post" novalidate>
          {% set selectedExpertType = values.PriorAuthorityExpertType if values else fallbackSelectedExpertType %}
          {% set otherExpertType = values.PriorAuthorityExpertTypeOther if values else fallbackOtherExpertType %}
          {% set displayedExpertType = otherExpertType if selectedExpertType == "Other" and otherExpertType else selectedExpertType %}
          {% set fullName = values.PriorAuthorityExpertFullName if values else priorAuthority.fullName %}
          <div class="govuk-form-group">
            <div style="display: flex; gap: 15px; align-items: flex-end;">
              <div style="flex-grow: 1;">
                {{ govukSelect({
                  id: "PriorAuthorityExpertType",
                  name: "PriorAuthorityExpertType",
                  errorMessage: ({ text: errorMap["PriorAuthorityExpertType"] } if errorMap["PriorAuthorityExpertType"] else null),
                  label: {
                    text: "Search for the expert type",
                    classes: "govuk-label--xl",
                    isPageHeading: true
                  },
                  value: selectedExpertType,

                  hint: {
                    text: "Choose from the dropdown. If the expert type is not listed, select Other and enter it below."
                  },
                  items: expertTypes
                }) }}
              </div>
            </div>
          </div>
          <noscript>
            {{ govukInput({
              label: {
                text: "If you selected Other, enter the expert type",
                classes: "govuk-label--m"
              },
              hint: {
                text: "Only complete this if you selected Other from the dropdown."
              },
              id: "PriorAuthorityExpertTypeOther",
              name: "PriorAuthorityExpertTypeOther",
              spellcheck: "false",
              value: otherExpertType,
              errorMessage: ({ text: errorMap["PriorAuthorityExpertTypeOther"] } if errorMap["PriorAuthorityExpertTypeOther"] else null)
            }) }}
          </noscript>
          <div id="expert-type-inset-text" hidden>
            {{ govukInsetText({
  text: "Only experts applicable to SCA cases appear in this list. If you cannot find the category of expert you are looking for, enter it manually."
}) }}
          </div>
          {{ govukInput({
            label: { text: "What is the full name of the expert?", classes: "govuk-label--m standard-spacing-top" },
            id: "PriorAuthorityExpertFullName",
            name: "PriorAuthorityExpertFullName",
            spellcheck: "false",
            value: fullName,
            errorMessage: ({ text: errorMap["PriorAuthorityExpertFullName"] } if errorMap["PriorAuthorityExpertFullName"] else null)
          }) }}
          <div class="govuk-button-group standard-spacing-top">
            {{ govukButton({ text: "Save and continue", attributes: { name: "_action", value: 'continue' } }) }}
            {{ govukButton({ text: "Save and come back later", classes: "govuk-button--secondary", attributes: { name: "_action", value: 'draft' } }) }}
          </div>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}"></form>
        </div>
      </div>
    </div>
    {% block pageScripts %}
      <link rel="stylesheet" href="/css/{{ getAsset('accessible-autocomplete', 'min.css') }}"/>
      <script nonce="{{ cspNonce }}" src="/js/{{ getAsset('accessible-autocomplete', 'min.js') }}"></script>
      <script nonce="{{ cspNonce }}">
        document.addEventListener("DOMContentLoaded", function () {
          const selectElement = document.querySelector('#PriorAuthorityExpertType');
          const hintElement = document.getElementById('PriorAuthorityExpertType-hint');
          const insetTextElement = document.getElementById('expert-type-inset-text');
          const displayedExpertType = {{ (displayedExpertType or '') | dump | safe }};
          if (selectElement && typeof accessibleAutocomplete !== 'undefined') {
            if (hintElement) {
              hintElement.textContent = 'Start typing and choose from the list. For example, physiotherapist.';
            }
            if (insetTextElement) {
              insetTextElement.hidden = false;
            }
            accessibleAutocomplete.enhanceSelectElement({selectElement: selectElement, displayMenu: 'overlay', defaultValue: displayedExpertType});
            const generatedInput = document.getElementById('PriorAuthorityExpertType');
            const originalSelect = document.getElementById('PriorAuthorityExpertType-select');
            if (generatedInput && originalSelect) {
              if (displayedExpertType) {
                generatedInput.value = displayedExpertType;
              }
              generatedInput.name = originalSelect.name;
              originalSelect.removeAttribute('name');
            }
          }
        });
      </script>
    {% endblock %}
  {% endblock %}