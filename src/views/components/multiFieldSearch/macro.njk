{% macro multiFieldSearch(action, fields, values = {}) %}
    <form method="get" action="{{ action }}" novalidate class="multi-field-search">
        <h2 class="govuk-heading-m">Search certificates</h2>
        {% for field in fields %}
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-!-font-weight-bold" for="{{ field.id }}">
                            {{ field.label }}
                        </label>
                        {% if field.hint %}
                            <div class="govuk-hint" id="{{ field.id }}-hint">
                                {{ field.hint }}
                            </div>
                        {% endif %}
                        <input class="govuk-input" id="{{ field.id }}" name="{{ field.name }}" type="{{ field.type | default('text') }}" value="{{ values[field.name] | default('') }}" {% if field.autocomplete %} data-search-options='{{ field.autocomplete | dump | safe }}' {% endif %} {% if field.hint %} aria-describedby="{{ field.id }}-hint" {% endif %}></div>
                    </div>
                </div>
            {% endfor %}
            <div class="govuk-button-group">
                <button class="govuk-button" type="submit">
                    Search
                </button>
                <a class="govuk-link govuk-link--no-visited-state" href="{{ action }}">
                    Clear
                </a>
            </div>
        </form>
    {% endmacro %}