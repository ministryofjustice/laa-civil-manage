# Server & Environment
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
ENABLE_HTTPS_ENFORCEMENT=false

# Service Metadata & Footer Links
SERVICE_NAME='laa-civil-manage'
SERVICE_PHASE='Beta'
DEPARTMENT_NAME='Legal Aid Agency'

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_WINDOW_MS=900000

# Session Management (SESSION_SECRET and SESSION_NAME are REQUIRED or app will crash on boot)
SESSION_NAME='sessionId'
SESSION_SECRET='local-dev-session-secret-change-me'
SESSION_REDIS_URL=
SESSION_MAX_AGE_MS=900000
SESSION_ABSOLUTE_TIMEOUT_MS=43200000

# Authentication (Entra ID / Azure AD)
SKIP_AUTH="true"
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_DIRECTORY_URL=
AUTH_REDIRECT_URL='http://localhost:3000/auth/redirect'
AUTH_LOGOUT_REDIRECT_URL='http://localhost:3000/auth/login'

# Backend Integration (Points to local API on 8080)
BACKEND_URL='http://localhost:8080'
MANAGE_API_SCOPE='api://<tenant-domain>/<manage-api-client-id>/access_as_user'