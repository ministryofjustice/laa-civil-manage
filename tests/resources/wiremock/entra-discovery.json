{
  "request": {
    "method": "GET",
    "urlPattern": "/mock-entra.*openid-configuration"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "issuer": "https://localhost:8443/mock-entra/v2.0",
      "authorization_endpoint": "https://localhost:8443/mock-entra/oauth2/v2.0/authorize",
      "token_endpoint": "https://localhost:8443/mock-entra/oauth2/v2.0/token",
      "jwks_uri": "https://localhost:8443/mock-entra/discovery/v2.0/keys",
      "response_types_supported": ["code", "id_token", "token"],
      "subject_types_supported": ["pairwise"],
      "id_token_signing_alg_values_supported": ["RS256"]
    }
  }
}
